# Base kitty config — settings only, NO colors
# Colors are appended by theme-set via themes/<theme>.conf
#
# To change settings: edit this file (and kitty.conf — they're kept in sync)
# To change theme: use `theme-set <name>` or Super+Shift+T

font_family      JetBrainsMono Nerd Font
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size 12.0
background_opacity 0.85
background_blur 24
dynamic_background_opacity no
window_padding_width 10

# Cursor
#cursor_trail 1
cursor_trail_decay 0.2 2
cursor_shape beam
cursor_beam_thickness 5.0
# cursor_text_color is set by the theme
cursor_blink_interval 0

# Scroll
wheel_scroll_multiplier 5.0
scrollback_lines 10000
scrollbar_handle_opacity 0
scrollbar_track_opacity 0
scrollbar_track_hover_opacity 0


# Window
# window_margin_width 6
remember_window_size no
initial_window_width  78c
initial_window_height 23c
window_padding_width  25
confirm_os_window_close 0

# Bell
enable_audio_bell no
enable_visual_bell no

# Selection / Mouse
selection_save_to_clipboard yes
mouse_hide_wait 3.0

# URLs
url_style curly

# Shell Integration
shell fish
shell_integration enabled

# -- Performance settings
sync_to_monitor no

# -- Perf
repaint_delay    8
input_delay      3

# Remote control (allows matugen-update to reload colors in running instances)
allow_remote_control socket-only
# Use abstract socket so kitty doesn't need to create files in XDG_RUNTIME_DIR
listen_on unix:@kitty

# Tab Bar
tab_bar_min_tabs 1
tab_bar_edge bottom
tab_bar_style powerline
tab_powerline_style slanted
tab_title_template "{title}{fmt.cwd} {' :{}:'.format(num_windows) if num_windows > 1 else ''}"

# Startup
startup_session none

# Scrollback pager
scrollback_pager less --chop-long-lines --RAW-CONTROL-CHARS +F
