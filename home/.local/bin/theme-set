#!/usr/bin/env bash
# theme-set <name> — switch kitty theme
#
# Concatenates kitty.conf.base + themes/<name>.conf → kitty.conf
# (No include directive used; theme IS the config.)
#
# Usage:
#   theme-set gruvbox-dark    # switch to specific theme
#   theme-set                 # show current theme name

set -euo pipefail

KITTY_DIR="$HOME/.config/kitty"
THEMES_DIR="$KITTY_DIR/themes"
BASE="$KITTY_DIR/kitty.conf.base"
CONF="$KITTY_DIR/kitty.conf"
MODE_FILE="$HOME/.config/current-theme"

NAME="${1:-}"
[[ -z "$NAME" ]] && cat "$MODE_FILE" 2>/dev/null && exit 0

[[ "$NAME" == "dynamic" ]] && { echo "dynamic mode not yet implemented (phase 3)" >&2; exit 1; }

THEME_FILE="$THEMES_DIR/$NAME.conf"
[[ -f "$BASE" ]] || { echo "missing base: $BASE" >&2; exit 1; }
[[ -f "$THEME_FILE" ]] || {
    echo "theme not found: $NAME" >&2
    echo "available: $(ls "$THEMES_DIR"/*.conf | xargs -n1 basename -s .conf | grep -v current | sort -u | tr '\n' ' ')" >&2
    exit 1
}

# Concatenate base + theme → new kitty.conf
cat "$BASE" "$THEME_FILE" > "$CONF"

# Update symlink for theme-rofi to show current theme name
ln -sfn "$NAME.conf" "$THEMES_DIR/current.conf"

echo "$NAME" > "$MODE_FILE"

# Try to reload running kitty (best-effort; new windows pick up new config automatically)
pkill -USR1 -x kitty 2>/dev/null || true

notify-send -a "Theme" -t 2000 "🎨 Theme: $NAME" 2>/dev/null || true
echo "theme: $NAME"
