#!/bin/bash
# theme-rofi — open rofi picker, then call theme-set with the chosen theme.
# Bound to Super+Shift+T.

KITTY_DIR="$HOME/.config/kitty/themes"

# Build theme list (one per line, skip 'current' symlink)
themes=""
for f in "$KITTY_DIR"/*.conf; do
    [ -f "$f" ] || continue
    name=$(basename "$f" .conf)
    [ "$name" = "current" ] && continue
    if [ -z "$themes" ]; then
        themes="$name"
    else
        themes="$themes
$name"
    fi
done

# Read current theme (for rofi prompt)
current=$(basename "$(readlink "$KITTY_DIR/current.conf" 2>/dev/null)" .conf 2>/dev/null)
[ -z "$current" ] && current="?"

# Toggle behavior: close rofi if already open, otherwise open it
if pgrep -x rofi >/dev/null 2>&1; then
    pkill -x rofi
    exit 0
fi

# Open rofi picker (theme-aware via style-dmenu.rasi)
selected=$(printf '%s\n' "$themes" | rofi -dmenu -i \
    -p " 🎨 Theme " \
    -mesg "current: $current | Esc to cancel" \
    -theme ~/.config/rofi/themes/style-dmenu.rasi)

# If user selected something, switch
if [ -n "$selected" ]; then
    exec /home/senthan/.local/bin/theme-set "$selected"
fi
exit 0
