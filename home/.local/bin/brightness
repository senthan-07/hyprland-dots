#!/usr/bin/env bash
# Brightness control — two hardcoded commands, no detection.
#
#   brightness laptop up     # +5% on internal (brightnessctl)
#   brightness laptop down   # -5% on internal
#   brightness ext up        # +5% on external (ddcutil -b 5 setvcp 10 + 5)
#   brightness ext down      # -5% on external

set -euo pipefail

DEVICE="${1:-}"
ACTION="${2:-}"
STEP=5

if [[ "$DEVICE" != "laptop" && "$DEVICE" != "ext" ]]; then
    echo "usage: $0 laptop|ext up|down" >&2; exit 1
fi
if [[ "$ACTION" != "up" && "$ACTION" != "down" ]]; then
    echo "usage: $0 laptop|ext up|down" >&2; exit 1
fi

# External bus hardcoded — find yours with: ddcutil detect | grep HDMI
EXT_BUS=5

case "$DEVICE" in
    laptop)
        if [[ "$ACTION" == "up" ]]; then
            brightnessctl set "${STEP}%+"
        else
            brightnessctl set "${STEP}%-"
        fi
        ;;
    ext)
        # ddcutil's getvcp returns cached value, so we use relative setvcp.
        # Syntax: ddcutil setvcp <code> + <delta>  or  setvcp <code> - <delta>
        if [[ "$ACTION" == "up" ]]; then
            ddcutil -b "$EXT_BUS" setvcp 10 + "$STEP" >/dev/null 2>&1
        else
            ddcutil -b "$EXT_BUS" setvcp 10 - "$STEP" >/dev/null 2>&1
        fi
        cur=$(ddcutil -b "$EXT_BUS" getvcp 10 --terse 2>/dev/null \
            | sed -n 's/.*current value =\s*\([0-9]\+\).*/\1/p')
        echo "ext: ${cur:-?}% (${ACTION} ${STEP})"
        ;;
esac
