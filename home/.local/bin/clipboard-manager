#!/usr/bin/env bash
# clipboard-manager — show cliphist history via rofi, restore selection to clipboard.
# Bound to Super+Alt+V.
#
# Toggle: if rofi is already open, second keypress closes it (pkill rofi).
# Theme: uses style-dmenu.rasi which follows the active Rofi theme automatically.

set -euo pipefail

# Guard: cliphist must be running (i.e. wl-paste watcher is alive)
if ! pgrep -x wl-paste >/dev/null 2>&1; then
    notify-send -u critical -t 3000 "Clipboard" "wl-paste watcher not running"
    exit 1
fi

# Build list (one per line; cliphist format: "<id>\t<preview>")
list="$(cliphist list)"
if [[ -z "$list" ]]; then
    notify-send -u low -t 2000 "Clipboard" "History empty"
    exit 0
fi

# Toggle behavior: close rofi if already open, otherwise open it
if pgrep -x rofi >/dev/null 2>&1; then
    pkill -x rofi
    exit 0
fi

# Rofi picker (theme-aware via style-dmenu.rasi)
selected="$(printf '%s\n' "$list" | rofi -dmenu -i \
    -p ' 󰨸  Clipboard ' \
    -mesg 'type to filter | Enter to copy | Esc to cancel' \
    -theme ~/.config/rofi/themes/style-dmenu.rasi)"

[[ -z "$selected" ]] && exit 0

# Extract cliphist id (first column, tab-separated)
id="$(printf '%s' "$selected" | awk '{print $1}')"
[[ -z "$id" ]] && exit 1

# Decode and copy back to clipboard
cliphist decode "$id" | wl-copy

# Confirmation
notify-send -u low -t 1500 "Clipboard" "Copied to clipboard"
